rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn() && request.auth.token.role == 'SUPER_ADMIN';
    }

    function isSchoolMember(schoolId) {
      return signedIn() && request.auth.token.schoolId == schoolId;
    }

    function isSchoolAdmin(schoolId) {
      return isSchoolMember(schoolId) && request.auth.token.role == 'SCHOOL_ADMIN';
    }

    function isTeacher(schoolId) {
      return isSchoolMember(schoolId) && request.auth.token.role == 'TEACHER';
    }

    function canReadSchool(schoolId) {
      return isSuperAdmin() || isSchoolMember(schoolId);
    }

    match /schools/{schoolId} {
      allow read: if canReadSchool(schoolId);
      allow create: if isSuperAdmin() || isSchoolMember(schoolId);
      allow update, delete: if isSuperAdmin() || isSchoolAdmin(schoolId);

      match /{collectionName}/{documentId} {
        allow read: if canReadSchool(schoolId);
        allow create: if isSuperAdmin() || isSchoolAdmin(schoolId) || isTeacher(schoolId);
        allow update: if isSuperAdmin() || isSchoolAdmin(schoolId) || isTeacher(schoolId);
        allow delete: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow update: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
